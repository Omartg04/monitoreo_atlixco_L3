# ─────────────────────────────────────────────────────────────────────────────
# Atlixco PIE L3 · .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── SECRETOS — nunca al repo ────────────────────────────────────────────────
# El repo es público: la private key de Bubble da acceso de lectura a TODA la
# base del operativo, y los hashes de contraseña son material para fuerza bruta
# offline. En Streamlit Cloud esto se configura en Settings → Secrets.
.streamlit/secrets.toml
secrets.toml
secrets_para_copiar.toml
*.secrets
.env
.env.*

# ── Datos del operativo ─────────────────────────────────────────────────────
# Respuestas individuales con coordenadas: no se publican. El dashboard las lee
# en vivo desde Bubble, no las necesita versionadas.
data/
datos/
exports/
*.csv
*.xlsx
*.xls
muestra_cruda_bubble_L3.json
base_auditada*.json
base_auditada*.csv

# Excepción: los insumos de configuración SÍ se versionan — config.py depende
# de puntos_muestra_L3.csv en tiempo de carga.
!puntos_muestra_L3.csv

# ── Audio de las grabaciones ────────────────────────────────────────────────
*.mp3
*.wav
*.m4a
grabaciones/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Entornos virtuales ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Streamlit ───────────────────────────────────────────────────────────────
.streamlit/
!.streamlit/config.toml

# ── Notebooks ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Editores ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Sistema operativo ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Logs y temporales ───────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/